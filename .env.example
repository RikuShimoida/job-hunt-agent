# SQLite のファイルパス。未指定時は ./job-hunt-agent.db
DATABASE_URL=./job-hunt-agent.db

# debug / info / warn / error。未指定時は info
LOG_LEVEL=info

# 案件通知の送信先。--dry-run なしの notify / run で必須
SLACK_WEBHOOK_URL=

# ソース取得失敗の送信先。未設定ならエラーは Slack へ送らず構造化ログにのみ残す
# SLACK_ERROR_WEBHOOK_URL=

# Gmail の読み取りに使う。sources.yaml の gmail ソースを有効にするなら3つとも必須
# （未設定のまま有効にすると起動時に停止する）。
#
# 1. Google Cloud Console でプロジェクトを作り、Gmail API を有効化する
# 2. OAuth クライアント ID（種類: デスクトップアプリ）を発行し、下の2つを設定する
# 3. `job-hunt-agent auth gmail` を実行し、表示されたトークンを GOOGLE_REFRESH_TOKEN へ貼る
#
# 要求するスコープは gmail.readonly のみ（削除・返信・ラベル変更は行わない）。
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
