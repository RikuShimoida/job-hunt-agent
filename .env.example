# SQLite のファイルパス。未指定時は ./job-hunt-agent.db
DATABASE_URL=./job-hunt-agent.db

# debug / info / warn / error。未指定時は info
LOG_LEVEL=info

# 案件通知の送信先。--dry-run なしの notify / run で必須
SLACK_WEBHOOK_URL=

# ソース取得失敗の送信先。未設定ならエラーは Slack へ送らず構造化ログにのみ残す
# SLACK_ERROR_WEBHOOK_URL=

# Phase 3 以降で使用する。Phase 2 では未使用
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
